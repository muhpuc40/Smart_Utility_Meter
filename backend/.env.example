# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed panel origins, or * for all
CORS_ORIGINS=*

# Proxies in front of the app: 1 = Render or Nginx only, 2 = Cloudflare + Render
TRUST_PROXY=1

# ------------------------------------------------------------
# SUPABASE  (Dashboard > Project Settings > API)
# Use the service_role key. Never put it in a frontend.
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# AUTH  (JWT_SECRET: at least 32 random characters)
# ------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# METER / BILLING
# ------------------------------------------------------------
# true  = consumer recharges are credited immediately (testing only)
# false = consumer recharges wait for admin approval
AUTO_APPROVE_RECHARGE=false

# A meter is "online" if it contacted the server within this many seconds
METER_ONLINE_SECONDS=180

# Time zone used for daily usage reports
APP_TIMEZONE=Asia/Dhaka
